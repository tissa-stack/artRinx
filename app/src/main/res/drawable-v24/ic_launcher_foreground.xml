<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground: the app logo (ic_app_logo, ~1.19:1) centred inside the 108dp foreground
    and kept within the ~66dp safe circle so the launcher's circular/squircle mask never clips it.
    Both mipmap-anydpi-v26/ic_launcher.xml and ic_launcher_round.xml reference this drawable.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_app_logo"
        android:width="44dp"
        android:height="37dp"
        android:gravity="center" />
</layer-list>
