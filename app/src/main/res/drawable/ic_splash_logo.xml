<?xml version="1.0" encoding="utf-8"?>
<!--
    Wraps ic_black_logo.png with insets so it renders at a smaller size within
    the Android 12+ splash icon container (240×240dp). Insets give the logo
    roughly 160dp wide × 64dp tall in the centre of the icon area.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="88dp"
        android:bottom="88dp"
        android:left="40dp"
        android:right="40dp">
        <bitmap
            android:src="@drawable/ic_black_logo"
            android:gravity="center"/>
    </item>
</layer-list>
